{
  "expo": {
    "name": "Rami Score",
    "slug": "suivi-rami",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "suivirami",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#161826",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#161826"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.suivirami.app"
    },
    "android": {
      "package": "com.suivirami.app",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "backgroundColor": "#161826"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-status-bar",
      "expo-font"
    ]
  }
}
